                         <p className="text-sm sarabun-font text-gray-900">
                           {item.qty} × {item.product_name}
                         </p>
                         <p className="text-[11px] text-gray-500 sarabun-font mt-0.5">
                           {item.product_code ? `รหัส: ${item.product_code} • ` : ""}
                           บรรจุ: {item.packing_list}
                         </p>
